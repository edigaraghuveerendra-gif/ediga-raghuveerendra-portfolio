<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <!-- Background -->
  <rect width="400" height="400" fill="#111111"/>
  <!-- Body silhouette -->
  <ellipse cx="200" cy="310" rx="110" ry="80" fill="#222222"/>
  <!-- Head circle -->
  <circle cx="200" cy="160" r="80" fill="#222222"/>
  <!-- Initials -->
  <text x="200" y="185" font-family="Inter, Arial, sans-serif" font-size="52" font-weight="900" fill="#ff2a2a" text-anchor="middle">ER</text>
  <!-- Red ring -->
  <circle cx="200" cy="200" r="195" fill="none" stroke="#ff2a2a" stroke-width="4" opacity="0.4"/>
</svg>
